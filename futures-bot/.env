# Binance Futures Bot — Development Environment
# Fill in your Binance API credentials before running.
# See .env.example for all available options.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://trader:trader_secret@postgres:5432/futures_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret
POSTGRES_DB=futures_bot

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Replace with your Binance Futures API keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com/fapi/v1
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_TESTNET=false

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

TRADING_MODE=SIMULATION
MAX_TRADERS=5
INITIAL_CAPITAL=1000
POSITION_SIZE=100
LEVERAGE=10
MARGIN_MODE=ISOLATED
HEDGE_DISTANCE=0.10
HEDGE_TP_PERCENT=0.50
HEDGE_SL_PERCENT=0.10
SHORT_TP_PERCENT=0.20
REFRESH_INTERVAL=60000
RETRY_LIMIT=5
FEE_RATE=0.0004
SLIPPAGE=0.0001

LOG_LEVEL=debug
LOG_DIR=logs
CORS_ORIGIN=http://localhost:3000
