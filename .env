# ─── Node ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://trader:trader_secret@postgres:5432/futures_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret
POSTGRES_DB=futures_bot

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Binance (keys from project) ─────────────────────────
BINANCE_API_KEY=f3kD8XP3SG0OpM9nr3x0mHG1eSoKXTMnweKYGBjiBWGkdZkxG2hcy8Zqbcrpx2KZ
BINANCE_SECRET_KEY=2s6hJvpEB850sHyHXJpo31GtzPhp72S9J8163wSPkOuSuQvuxbGBnOu8aMobkiWE
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com/fapi/v1
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# ─── Authentication ──────────────────────────────────────
JWT_SECRET=MONEYMONEYMONEY_extended_to_32chars_xxxx

# ─── Trading ─────────────────────────────────────────────
# SIMULATION = real prices, no real orders (safe default)
TRADING_MODE=SIMULATION
RESET_DB_ON_START=true
MAX_TRADERS=4
INITIAL_CAPITAL=2000
POSITION_SIZE=100
LEVERAGE=10
MARGIN_MODE=ISOLATED

# Near-price directional grid
TRADER_BEHAVIOR=near_price_directional
# levelsPerSide = floor(boundary / spacing) = floor(30 / 2) = 15
GRID_SPACING_PERCENT=2
GRID_BOUNDARY_PERCENT=30
GRID_LEVELS_PER_SIDE=15
# true = triangular side-pool scaling; false = equal margin across all levels
GRID_CAPITAL_SCALING_ENABLED=false
GRID_ACTIVATION_MULTIPLIER=2
STOP_LIMIT_OFFSET_PERCENT=0.05
TRADER_MAX_LIFETIME_HOURS=12

TOP_GAINERS_LIMIT=50
REFRESH_INTERVAL=60000
RETRY_LIMIT=5
# Binance Futures fee rates (VIP0 regular: maker 0.02%, taker 0.05%)
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE=0.0001

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Frontend ────────────────────────────────────────────
CORS_ORIGIN=https://mockworlds.com
