# ─── Node ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
WORKER_PORT=3002

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://trader:trader_secret@postgres:5432/futures_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret
POSTGRES_DB=futures_bot

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Binance (keys from project) ─────────────────────────
BINANCE_API_KEY=f3kD8XP3SG0OpM9nr3x0mHG1eSoKXTMnweKYGBjiBWGkdZkxG2hcy8Zqbcrpx2KZ
BINANCE_SECRET_KEY=2s6hJvpEB850sHyHXJpo31GtzPhp72S9J8163wSPkOuSuQvuxbGBnOu8aMobkiWE
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com/fapi/v1
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_TESTNET=false

# ─── Authentication ──────────────────────────────────────
JWT_SECRET=MONEYMONEYMONEY_extended_to_32chars_xxxx

# ─── Trading ─────────────────────────────────────────────
# SIMULATION = real prices, no real orders (safe default)
TRADING_MODE=SIMULATION
RESET_DB_ON_START=true
MAX_TRADERS=4
INITIAL_CAPITAL=2000
POSITION_SIZE=100
LEVERAGE=10
MARGIN_MODE=ISOLATED
TRADER_LIFETIME_HOURS=6
TAKE_PROFIT_PERCENT=0.01
STOP_LOSS_PERCENT=0.01
STARTING_SIDE=SHORT
CAPITAL_STEPS=10
SWITCH_POSITION_ON_TAKE_PROFIT=false

# Hold-to-exhaustion two-sided grid
TRADER_BEHAVIOR=grid_directional
GRID_LEVELS_PER_SIDE=10
GRID_DISTANCE_PERCENT=1
# Deprecated for exits (ignored by hold-to-exhaustion strategy)
TRADER_TAKE_PROFIT_PERCENT=10
TRADER_MAX_LIFETIME_HOURS=12

# Trend confirmation filter (required for trader creation)
TREND_DETECTION_ENABLED=true
TREND_PRIMARY_TIMEFRAME=15m
TREND_CONFIRMATION_TIMEFRAME=1h
TREND_EMA_FAST=20
TREND_EMA_SLOW=50
TREND_ADX_PERIOD=14
TREND_MIN_ADX=25
TREND_STRONG_ADX=30
TREND_VOLUME_MULTIPLIER=1.2
TREND_MIN_CONFIRMATION_SCORE=4
TREND_STRONG_MIN_SCORE=6
TREND_ROC_PERIOD=10
TREND_MOMENTUM_THRESHOLD=0.5
TREND_ANALYSIS_CONCURRENCY=5
TREND_RESULT_CACHE_SECONDS=60
TREND_RESULT_MAX_AGE_SECONDS=300
TOP_GAINERS_LIMIT=50

# How often to refresh top gainers + full trend scan (ms)
REFRESH_INTERVAL=60000
RETRY_LIMIT=5
# Binance Futures fee rates (VIP0 regular: maker 0.02%, taker 0.05%)
FEE_RATE=0.0005
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
SLIPPAGE=0.0001

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Frontend ────────────────────────────────────────────
CORS_ORIGIN=https://mockworlds.com
