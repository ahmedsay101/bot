# ============================================================
# Binance Futures Trading Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Node ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
WORKER_PORT=3002

# ─── Database ────────────────────────────────────────────
# Automatically overridden by docker-compose to point at the postgres container.
DATABASE_URL=postgresql://trader:trader_secret@localhost:5432/futures_bot
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret
POSTGRES_DB=futures_bot

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Binance ─────────────────────────────────────────────
# Futures Testnet: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com/fapi/v1
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_TESTNET=false

# ─── Authentication ──────────────────────────────────────
# Generate a strong random 32+ character secret
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# ─── Trading ─────────────────────────────────────────────
# SIMULATION: uses real prices, simulated fills (default — safe for testing)
# LIVE: places real orders on Binance Futures
TRADING_MODE=SIMULATION

# Wipe traders/orders/positions/trades + reset testing balance on every boot
# Set false only if you need crash-recovery of open traders
RESET_DB_ON_START=true

MAX_TRADERS=1
INITIAL_CAPITAL=2000
POSITION_SIZE=100
LEVERAGE=10
MARGIN_MODE=ISOLATED

# Trader lifetime before destroy + replacement (hours)
TRADER_LIFETIME_HOURS=24
# Take profit distance from entry (10% = 0.10) — reopens SAME side
TAKE_PROFIT_PERCENT=0.10
# Stop loss distance from entry (10% = 0.10) — reopens OPPOSITE side
STOP_LOSS_PERCENT=0.10
# First position side
STARTING_SIDE=SHORT
# Capital steps from trader allocation (Step N = allocation × N / steps)
CAPITAL_STEPS=5
# When true: TP opens opposite side, SL opens same side. Default false = TP same / SL opposite
SWITCH_POSITION_ON_TAKE_PROFIT=false

# Directional grid settings
# Grid levels above and below start price
GRID_LEVELS_PER_SIDE=10
# Distance between grid levels (%). Also used as per-level TP and SL distance from entry.
GRID_DISTANCE_PERCENT=2
# true = existing triangular capital scaling within each side
# false = equal margin = traderAllocation / totalGridLevels; multiple positions allowed
GRID_CAPITAL_SCALING_ENABLED=true
# Deprecated as trader-wide exit % (ignored); per-level TP/SL use GRID_DISTANCE_PERCENT
TRADER_TAKE_PROFIT_PERCENT=10
# Max lifetime for grid traders (hours)
TRADER_MAX_LIFETIME_HOURS=12

# Trend confirmation filter (required for trader creation)
# Obsolete for trader creation (kept for optional legacy tooling; default false).
# Traders are selected from top gainers by MAX_TRADERS — no trend confirmation.
TREND_DETECTION_ENABLED=false
TREND_PRIMARY_TIMEFRAME=15m
TREND_CONFIRMATION_TIMEFRAME=1h
TREND_EMA_FAST=20
TREND_EMA_SLOW=50
TREND_ADX_PERIOD=14
TREND_MIN_ADX=22
TREND_STRONG_ADX=28
TREND_VOLUME_MULTIPLIER=1.1
TREND_MIN_CONFIRMATION_SCORE=4
TREND_STRONG_MIN_SCORE=6
TREND_ROC_PERIOD=10
TREND_MOMENTUM_THRESHOLD=0.5
TREND_ANALYSIS_CONCURRENCY=5
TREND_RESULT_CACHE_SECONDS=60
TREND_RESULT_MAX_AGE_SECONDS=300
# Selective engine — moderate relaxation (smart + realistic frequency)
TREND_MIN_STRONG_CONFIDENCE=72
TREND_MIN_EFFICIENCY=0.45
TREND_MIN_ROOM_ATR=1.0
TREND_MAX_REVERSAL_RISK=75
TREND_MIN_MTF_AGREE=2
TREND_MIN_CATEGORY_CONFIRMED=4
TREND_MIN_CORE_CONFIRMED=4
TREND_DEVELOPING_STRONG_ENABLED=true
TREND_STRONG_REGIME_ENABLED=true
TOP_GAINERS_LIMIT=50

# How often to refresh top gainers (ms)
REFRESH_INTERVAL=60000
# Max order placement retry attempts
RETRY_LIMIT=5
# Binance Futures fee rates (VIP0 regular: maker 0.02%, taker 0.05%)
FEE_RATE=0.0005
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.0005
# Price slippage for market orders
SLIPPAGE=0.0001

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Frontend ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
