generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TraderStatus {
  INITIALIZING
  ACTIVE
  PAUSED
  COMPLETING
  COMPLETED
  FAILED
}

enum TraderMode {
  LIVE
  SIMULATION
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LIMIT
  TAKE_PROFIT
  STOP_MARKET
  TAKE_PROFIT_MARKET
}

enum OrderStatus {
  PENDING
  NEW
  TRIGGERED
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  EXPIRED
}

enum PositionSide {
  LONG
  SHORT
  BOTH
}

/// SHORT / LONG for V2; HEDGE kept for legacy rows (treat as LONG)
enum HedgeRole {
  SHORT
  HEDGE
  LONG
}

model Trader {
  id              String       @id @default(uuid())
  symbol          String
  mode            TraderMode
  status          TraderStatus @default(INITIALIZING)
  leverage        Int
  marginMode      String
  initialCapital  String
  positionSize    String

  /// Strategy V2 lifetime
  startedAt       DateTime?
  endsAt          DateTime?

  /// Current open position
  currentSide           String?
  currentPositionNumber Int      @default(0)
  entryPrice            String?
  tpPrice               String?
  slPrice               String?
  quantity              String?

  /// Lifecycle counters
  positionsOpened   Int @default(0)
  positionsClosed   Int @default(0)
  winningPositions  Int @default(0)
  losingPositions   Int @default(0)
  takeProfits       Int @default(0)
  stopLosses        Int @default(0)
  longPositions     Int @default(0)
  shortPositions    Int @default(0)
  totalFees         String @default("0")

  /// JSON array of PositionTimelineEntry
  timelineJson      String @default("[]")

  realizedPnl     String       @default("0")
  unrealizedPnl   String       @default("0")
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders     Order[]
  positions  Position[]
  trades     Trade[]
  statistics TraderStatistics?

  @@index([symbol])
  @@index([status])
}

model Order {
  id              String      @id @default(uuid())
  traderId        String
  exchangeOrderId String?     @unique
  clientOrderId   String      @unique
  symbol          String
  side            OrderSide
  type            OrderType
  status          OrderStatus @default(PENDING)
  role            HedgeRole
  /// Position number (1-based)
  hedgeLevel      Int         @default(0)
  quantity        String
  price           String?
  stopPrice       String?
  filledQuantity  String      @default("0")
  avgFillPrice    String?
  fee             String      @default("0")
  feeCurrency     String?
  reduceOnly      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  filledAt        DateTime?

  trader Trader @relation(fields: [traderId], references: [id])

  @@index([traderId])
  @@index([symbol])
  @@index([status])
  @@index([clientOrderId])
}

model Position {
  id               String       @id @default(uuid())
  traderId         String
  symbol           String
  side             PositionSide
  role             HedgeRole
  hedgeLevel       Int          @default(0)
  entryPrice       String
  quantity         String
  leverage         Int
  unrealizedPnl    String       @default("0")
  realizedPnl      String       @default("0")
  liquidationPrice String?
  markPrice        String?
  isOpen           Boolean      @default(true)
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  trader Trader @relation(fields: [traderId], references: [id])

  @@index([traderId])
  @@index([symbol])
  @@index([isOpen])
}

model Trade {
  id          String    @id @default(uuid())
  traderId    String
  orderId     String
  symbol      String
  side        OrderSide
  role        HedgeRole
  hedgeLevel  Int       @default(0)
  quantity    String
  price       String
  fee         String
  feeCurrency String
  realizedPnl String    @default("0")
  tradeTime   DateTime
  createdAt   DateTime  @default(now())

  trader Trader @relation(fields: [traderId], references: [id])

  @@index([traderId])
  @@index([symbol])
}

model TraderStatistics {
  id              String   @id @default(uuid())
  traderId        String   @unique
  symbol          String
  mode            TraderMode
  shortEntryPrice String   @default("0")
  shortExitPrice  String?
  totalHedgeLevels Int     @default(0)
  hedgeWins       Int      @default(0)
  hedgeLosses     Int      @default(0)
  totalFees       String   @default("0")
  realizedPnl     String   @default("0")
  peakUnrealizedPnl String @default("0")
  durationMs      BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trader Trader @relation(fields: [traderId], references: [id])
}

model GlobalStatistics {
  id              String     @id @default("singleton")
  totalTraders    Int        @default(0)
  activeTraders   Int        @default(0)
  completedTraders Int       @default(0)
  totalRealizedPnl String    @default("0")
  totalFees       String     @default("0")
  dailyPnl        String     @default("0")
  winRate         String     @default("0")
  lastUpdated     DateTime   @default(now())
}

model AccountLedger {
  id              String   @id @default("singleton")
  balance         String   @default("200")
  realizedPnl     String   @default("0")
  totalFees       String   @default("0")
  dailyPnl        String   @default("0")
  dailyPnlDate    String   @default("")
  updatedAt       DateTime @updatedAt
}

model Configuration {
  id              String   @id @default("singleton")
  maxTraders      Int      @default(1)
  initialCapital  String   @default("1000")
  positionSize    String   @default("100")
  leverage        Int      @default(10)
  marginMode      String   @default("ISOLATED")
  traderLifetimeHours Int  @default(24)
  takeProfitPercent String @default("0.10")
  stopLossPercent   String @default("0.10")
  startingSide      String @default("SHORT")
  refreshInterval Int      @default(60000)
  retryLimit      Int      @default(5)
  feeRate         String   @default("0.0004")
  slippage        String   @default("0.0001")
  mode            TraderMode @default(SIMULATION)
  isPaused        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AppLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  context   String?
  meta      String?
  timestamp DateTime @default(now())

  @@index([level])
  @@index([timestamp])
}
